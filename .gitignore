# ═══════════════════════════════════════════════════════════════════
# RemoteOllama .gitignore
# ═══════════════════════════════════════════════════════════════════

# ── Python bytecode & cache ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ── Build artifacts ────────────────────────────────────────────
build/
dist/
eggs/
*.egg
*.egg-info/
sdist/
*.whl
*.manifest
*.spec.bak

# ── Virtual environments ───────────────────────────────────────
.venv/
venv/
env/
.env/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# ── IDE & Editor ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.pydevproject
.settings/
.classpath

# ── OS generated files ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Project documentation (internal only) ──────────────────────
prompt.md
DESIGN.md

# ── Runtime data (user-specific, generated at runtime) ────────
config.json
*.db
*.db-wal
*.db-shm
*.db-journal

# ── Logs ───────────────────────────────────────────────────────
*.log
*.log.*
logs/
log/

# ── Environment & secrets ──────────────────────────────────────
.env
.env.*
.env.local
.env.production
.env.development
*.secret
secrets.yaml
credentials.json
*.pem
*.key
*.crt
app/config/local_config.py

# ── Buildozer (Android) ────────────────────────────────────────
.buildozer/
bin/
.android/
.gradle/

# ── PyInstaller ────────────────────────────────────────────────
*.spec.bak
pyinstaller/

# ── Testing & Coverage ─────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.benchmarks/

# ── Type checking ──────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── Jupyter ────────────────────────────────────────────────────
*.ipynb_checkpoints/
.ipynb_checkpoints/

# ── Packaging ──────────────────────────────────────────────────
*.deb
*.rpm
*.AppImage
*.apk
*.aab
*.exe
*.msi

# ── Archives ───────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz
*.7z
*.rar

# ── Misc ───────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
